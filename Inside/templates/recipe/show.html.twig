{% extends 'Main.html.twig' %}

{% block title %}Recipe{% endblock %}

{% block main %}
    <h1>Recipe</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ recipe.id }}</td>
            </tr>
            <tr>
                <th>Time</th>
                <td>{{ recipe.time }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ recipe.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ recipe.description }}</td>
            </tr>
            <tr>
                <th>Step</th>
                <td>{{ recipe.step }}</td>
            </tr>
            <tr>
                <th>NbPerson</th>
                <td>{{ recipe.nbPerson }}</td>
            </tr>
            <tr>
                <td>{% if recipe.allergys %}
                    {{ recipe.allergys|map(a => a.value)|join(', ') }}
                    {% else %}
                    Aucune allergie définie</td>
                {% endif %}
            </tr>
            <tr>
                <td> {% if recipe.diet %}
                        {{ recipe.diet.value }}
                    {% else %}
                        Aucun régime alimentaire définie
                    {% endif %}</td>

            </tr>
            <tr>
                <th>ImageLink</th>
                <td>{{ recipe.imageLink }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_recipe_index') }}">back to list</a>

    <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}">edit</a>

    {{ include('recipe/_delete_form.html.twig') }}
{% endblock %}
