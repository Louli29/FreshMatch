<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4 shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="mb-3">
                        <div class="form-floating">
                            {{ form_row(form.name) }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_row(form.allergys) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.diet) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            {{ form_row(form.ingredientRecipe) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            {{ form_row(form.step) }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_row(form.time) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.nbPerson) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            {{ form_row(form.description) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            {{ form_row(form.imageLink) }}
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Sauvegarder</button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: #D4B585;
        border-radius: 15px;
    }

    .form-floating label {
        color:rgb(0, 0, 0);
    }

    .btn-success {
        padding: 12px 30px;
        font-size: 18px;
    }
</style>
