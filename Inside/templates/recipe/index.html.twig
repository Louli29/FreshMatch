{% extends 'Main.html.twig' %}

{% block title %}Recipe Index{% endblock %}

{% block main %}
    <div class="text-center my-5">
        <h1>Les recettes</h1>
    </div>

    <div class="container">
        <div class="row">
            {% for recipe in recipes %}
                <div class="col-12 mb-4">
                    <div class="card d-flex flex-row shadow-sm">
                        <img src="{{ recipe.imageLink != '' ? recipe.imageLink : 'https://via.placeholder.com/150' }}" class="card-img-left" alt="{{ recipe.name }}" style="width: 150px; height: 150px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title">{{ recipe.name }}</h5>
                            <p class="card-text">{{ recipe.description | slice(0, 100) }}...</p>

                            <ul class="list-unstyled">
                                <li><strong>Temps :</strong> {{ recipe.time }} minutes</li>
                                <li><strong>Etapes :</strong> {{ recipe.step | slice(0, 100) }}...</li>
                                <li><strong>Nombre de personne :</strong> {{ recipe.nbPerson }} personnes</li>
                                <li><strong>Régime alimentaire :</strong> {{ recipe.diet ? recipe.diet.value : 'Aucun régime alimentaire' }}</li>
                                <li><strong>Allergies :</strong> 
                                    {% if recipe.allergys is not empty %}
                                        {{ recipe.allergys | map(a => a.value) | join(', ') }}
                                    {% else %}
                                        Aucune allergie
                                    {% endif %}
                                </li>
                            </ul>

                            <div class="d-flex justify-content-start gap-2">
                                <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-primary btn-sm">Afficher la recette</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-warning" role="alert">
                        Aucune recette trouvée.
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="text-center mt-4 pb-4">
            <a href="{{ path('home_page') }}" class="btn btn-success btn-lg">Retourner à la page d'accueil</a>
        </div>
    </div>
{% endblock %}
