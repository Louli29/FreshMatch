{% extends 'base.html.twig' %}

{% block title %}Mon placard{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">

                {% if listIngrUser.ingredient|length > 0 %}
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Nom de l'ingrédient</th>
                            <th>Type</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for ingredient in listIngrUser.ingredient %}
                            <tr>
                                <th scope="row">{{ loop.index }}</th>
                                <td>{{ ingredient.name }}</td>
                                <td>{{ ingredient.typeIngredient.value|capitalize }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="alert alert-info">Aucun ingrédient dans votre placard pour le moment.</p>
                {% endif %}

                <div class="text-center mt-4">
                    <button id="show-add-ingredient" class="btn btn-success">+ Ajouter des ingrédients</button>

                    <div id="ingredient-search-container" class="mt-3" style="display: none;">
                        <input type="text" id="ingredient-search" class="form-control" placeholder="Rechercher un ingrédient...">
                        <ul id="ingredient-suggestions" class="list-group mt-2"></ul>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const addButton = document.getElementById("show-add-ingredient");
                    const searchContainer = document.getElementById("ingredient-search-container");
                    const searchInput = document.getElementById("ingredient-search");
                    const suggestionList = document.getElementById("ingredient-suggestions");
                    const placardTable = document.querySelector("tbody");

                    addButton.addEventListener("click", function () {
                        searchContainer.style.display = "block";
                        searchInput.focus();
                    });

                    searchInput.addEventListener("input", function () {
                        const query = searchInput.value.trim();

                        if (query.length < 2) {
                            suggestionList.innerHTML = "";
                            return;
                        }

                        fetch(`/autocomplete/ingredients?term=${query}`)
                            .then(response => response.json())
                            .then(data => {
                                suggestionList.innerHTML = "";
                                data.forEach(ingredient => {
                                    const item = document.createElement("li");
                                    item.classList.add("list-group-item", "list-group-item-action");
                                    item.textContent = ingredient.name;
                                    item.dataset.id = ingredient.id;

                                    item.addEventListener("click", function () {
                                        addIngredientToUser(ingredient);
                                        searchInput.value = "";
                                        suggestionList.innerHTML = "";
                                        searchContainer.style.display = "none";
                                    });

                                    suggestionList.appendChild(item);
                                });
                            })
                            .catch(error => console.error("Erreur lors de la récupération des ingrédients :", error));
                    });

                    function addIngredientToUser(ingredient) {
                        fetch('/add-ingredient', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ ingredient_id: ingredient.id })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    const newRow = document.createElement("tr");
                                    newRow.innerHTML = `
                        <th scope="row">${placardTable.children.length + 1}</th>
                        <td>${ingredient.name}</td>
                        <td>${ingredient.type.charAt(0).toUpperCase() + ingredient.type.slice(1)}</td>
                    `;
                                    placardTable.appendChild(newRow);
                                }
                            })
                            .catch(error => console.error("Erreur lors de l'ajout de l'ingrédient :", error));
                    }
                });
            </script>


        </div>
    </div>
{% endblock %}