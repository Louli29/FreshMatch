<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    .custom-bg {
        background-color: #4B8947; 
    }

    .btn-custom {
        background-color: #CDA37B; 
        color: white;
        border: none;
    }
    .btn-custom:hover {
        background-color: #b68f6a; 
    }

    .btn-danger {
        background-color: red;
        border: none;
    }
</style>

<nav class="navbar navbar-expand-lg custom-bg">
    <div class="container-fluid d-flex justify-content-end py-2">
        {% if app.user %}
            <a class="btn btn-custom btn-lg me-2" href="{{ path('app_user_account', { 'id': app.user.id }) }}">Mon compte</a>
            <form action="{{ path('app_logout') }}" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger btn-lg">Déconnexion</button>
            </form>
        {% else %}
            <a class="btn btn-custom btn-lg" href="{{ path('app_login') }}">Se connecter</a>
        {% endif %}
    </div>
</nav>

<header class="container-fluid custom-bg py-5">
    <div class="container d-flex flex-column align-items-start">
        <h1 class="fw-bold align-self-start text-white" style="font-size: 6rem;">
            Fresh<span style="color: #076407;">Match</span>
        </h1>
        <div class="align-self-end mt-4">
            <h2 class="slogan fs-1 text-white text-end">
                <span>Rien ne se <span style="color: #CDA37B;">jette</span>,</span><br>
                <span>tout se <span style="color: #076407;">savoure</span> !</span>
            </h2>
        </div>
    </div>
</header>
