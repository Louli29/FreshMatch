{% extends 'main.html.twig' %}


{% block stylesheets %}
    <link href="{{asset('/css/style.css')}}" rel="stylesheet">
{% endblock %}

{% block main %}
    <article class="first-article">
        <h4 class="title"> Dis-nous ce que tu as, on te dira quoi cuisinier !</h4>
        <div class="container-homepage">
         <button class="buttonIngredient">Fais parler tes ingrédients !</button> 
        </div>
    </article>

    <article class="second-article">
        <h4 class="title2"> Nos recettes top chrono </h4>
        <table>
            <tr>
                <td><img src="pictures/recette1.jpg" alt ="text alternatif"> </td>
                <td><img src="pictures/recette2.jpg" alt ="text alternatif"> </td>
                <td><img src="pictures/recette3.png" alt ="text alternatif"> </td>
            </tr>
            <tr>
                <td><img src="pictures/recette4.png" alt ="text alternatif"> </td>
                <td><img src="pictures/recette5.jpg" alt ="text alternatif"> </td>
                <td><img src="pictures/recette6.jpg" alt ="text alternatif"> </td>
            </tr>
        </table>
    </article>

    <article class="second-article">
    <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Temps de préparation</th>
                <th>Nom de la recette</th>
                <th>Description</th>
                <th>step</th>
                <th>nb_person</th>
                <th>allergys</th>
                <th>Diet</th>

            </tr>
            </thead>
            <tbody>
            {% for recipe in recipes %}
                <tr>
                    <td>{{ recipe.id }}</td>
                    <td>{{ recipe.time }} minutes</td>
                    <td>{{ recipe.name }}</td>
                    <td>{{ recipe.description }}</td>
                    <td>{{ recipe.step}}</td>
                    <td>{{ recipe.nbPerson }}</td>
                    <td>{{ recipe.allergys is not null ? recipe.allergys | join(', ') : 'Aucune allergie' }}</td>
                    <td>{{ recipe.diet }}</td>
                </tr>
            {% endfor %}
    </article>

    <article class="tirth-acticle">
        <h4 class="title2"> Nos recettes de saison en 
        {% for saison,dates in saisons %}
            {% if dateActuelle >= dates.start and dateActuelle <= dates.end %}
                {% if saison == 'spring' %}
                    Printemps  </h4>
                    <table>
                        <tr>
                            <td><a href="#"><img src="pictures/GrilledGoatCheeseSalad.png" alt ="GrilledGoatCheeseSalad img"> </a> </td>
                            <td><a href="#"><img src="pictures/ChickenRisottoWeight.jpg" alt ="ChickenRisottoWeight img"></a> </td>
                            <td><a ><img src="pictures/StrawberryTart.png" alt ="StrawberryTart img"></a></td>
                        </tr>                        
                    </table>
                {% endif %}
                {% if saison == 'summer' %}
                 Eté  </h4>
                <table>
                    <tr>
                        <td><a href="#"><img src="pictures/MelonFetaMintSalad.webp" alt ="MelonFetaMintSalad img"></a></td>
                        <td><a href="#"><img src="pictures/FishCeviche.png" alt ="FishCeviche img"></a></td>
                        <td><a href="#"><img src="pictures/PastaWithPesto.png" alt ="PastaWithPesto img"></a></td>
                    </tr>
                    
                </table>
                {% endif %}
                {% if saison == 'autumn' %}
                 Automne  </h4>
                <table>
                    <tr>
                        <td><a href="#"><img src="pictures/PumpkinSoup.jpeg" alt ="text alternatif"></a></td>
                        <td><a href="#"><img src="pictures/MeatStewWithRootVegetables.jpg" alt ="text alternatif"></a></td>
                        <td><a href="#"><img src="pictures/AppleAndCinnamonPie.JPG" alt ="text alternatif"></a></td>
                    </tr>
                </table>
                {% endif %}
                {% if saison == 'winter' %}
                 Hiver  </h4>
                <table>
                    <tr>
                        <td><a href="#"><img src="pictures/ChiliConCarne.jpg" alt ="text alternatif"></a></td>
                        <td><a href="#"><img src="pictures/DauphinoiseGratin.jpg" alt ="text alternatif"></a></td>
                        <td><a href="#"><img src="pictures/ChocolateAndOrangeCake.png" alt ="text alternatif"></a></td>
                    </tr>
                </table>
                {% endif %}
            {% endif %}
        {% endfor %}
    </article>

<style>
.tirth-acticle{
  background: linear-gradient(to bottom, #095227, #4B8947);
}

.tirth-acticle img{
  background: linear-gradient(to bottom, #095227, #4B8947);
  width: 100px; 
  height: 100px;

}
</style>
{% endblock %}