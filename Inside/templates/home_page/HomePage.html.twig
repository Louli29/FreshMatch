{% extends 'main.html.twig' %}

{% block main %}
	<article class="first-article text-center">
		<h4 class="title">Dis-nous ce que tu as, on te dira quoi cuisiner !</h4>
		<div class="container-homepage">
			<a class="btn btn-success" href="{{ path('recipe_research') }}">
				Fais parler tes ingrédients !
			</a>
		</div>
	</article>

	<article class="article">
		{% if saison == "SPRING" %}
			<h4 class="title text-center text-white">Nos recettes de Printemps !</h4>
		{% endif %}
		{% if saison == "SUMMER" %}
			<h4 class="title text-center text-white">Nos recettes d'Eté !</h4>
		{% endif %}
		{% if saison == "AUTUMN" %}
			<h4 class="title text-center text-white">Nos recettes d'Automne !</h4>
		{% endif %}
		{% if saison == "WINTER" %}
			<h4 class="title text-center text-white">Nos recettes d'Hiver !</h4>
		{% endif %}

		<div class="table-responsive text-center">
			<table class="table border-0">
				<tr>
					{% for recipe in recipes %}
						<td class="recipeTitle">{{ recipe.name }}</td>
					{% endfor %}
				</tr>
				<tr>
					{% for recipe in recipes %}
						<td>
							<a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="articleLink">
								<img src="{{ (recipe.imageLink) }}" alt="{{ recipe.name }}" class="recipe-image">
							</a>
						</td>
					{% endfor %}
				</tr>
			</table>
		</div>
	</article>

	<style>
		.first-article {
			margin-top: 20px; 
		}

		.article {
			background: linear-gradient(to bottom, #095227, #4B8947);
			padding-bottom: 20px;
		}

		.articleLink img {
			transition: transform 0.3s ease-in-out;
			width: 200px;
			height: 200px;
			object-fit: cover;
		}

		.articleLink img:hover {
			transform: scale(1.1);
			filter: brightness(1.2);
		}

		.recipeTitle {
			text-align: center;
			font-weight: bold;
			padding: 10px;
			color: #CDA37B;
		}

		.recipe-image {
			border-radius: 10px;
		}

		.article .title {
			margin-top: 20px;
		}

		table td, table th {
			border: none;
		}
	</style>

{% endblock %}
