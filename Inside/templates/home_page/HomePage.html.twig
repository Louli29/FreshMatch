{% extends 'main.html.twig' %}


{% block stylesheets %}
    <link href="{{asset('/css/style.css')}}" rel="stylesheet">
{% endblock %}

{% block main %}
    <article class="first-article">
        <h4 class="title"> Dis-nous ce que tu as, on te dira quoi cuisinier !</h4>
        <div class="container-homepage">
         <button class="buttonIngredient">Fais parler tes ingrédients !</button> 
        </div>
    </article>

    <article class="second-article">
        <h4 class="title2"> Nos recettes top chrono </h4>
        <table>
            <tr>
                <td><img src="pictures/recette1.jpg" alt ="text alternatif"> </td>
                <td><img src="pictures/recette2.jpg" alt ="text alternatif"> </td>
                <td><img src="pictures/recette3.png" alt ="text alternatif"> </td>
            </tr>
            <tr>
                <td><img src="pictures/recette4.png" alt ="text alternatif"> </td>
                <td><img src="pictures/recette5.jpg" alt ="text alternatif"> </td>
                <td><img src="pictures/recette6.jpg" alt ="text alternatif"> </td>
            </tr>
        </table>
    </article>

    <article class="tirth-acticle">
    {% if saison == "SPRING" %}
        <h4 class="title"> Nos recettes de Printemps !</h4>
    {% endif %}
    {% if saison == "SUMMER" %}
        <h4 class="title"> Nos recettes d'Eté !</h4>
    {% endif %}
    {% if saison == "AUTUMN" %}
        <h4 class="title"> Nos recettes d'Automne !</h4>
    {% endif %}
    {% if saison == "WINTER" %}
        <h4 class="title"> Nos recettes d'Hiver !</h4>
    {% endif %}
        <table>
            <tr>
                {% for recipe in recipes %}
                  <td class="recipeTitle"> {{recipe.name}}</td>
                {% endfor %}
            </tr>
            <tr>
                {% for recipe in recipes %}
                    <td> <a href="{{path('app_recipe_show', {'id': recipe.id})}}" class="thirthArticleLink"><img src="/pictures/{{recipe.imageLink}}" alt ="{{ recipe.imageLink }} picture " title="Cliquez pour voir la recette !"> </a></td>                {% endfor %}
            </tr>
            
        </table>
    </article>


<style>
.tirth-acticle{
    background-color: #F9EEE0;
    padding-bottom:50px;
}

.thirthArticleLink img {
    transition: transform 0.3s ease-in-out;
    width: 200px; 
    height: 200px;
    padding: 20px;
}

.thirthArticleLink img:hover {
    transform: scale(1.1);
    filter: brightness(1.2);
}
.recipeTitle {
    text-align: center;
    font-weight: bold;
    padding: 10px;
    color: #CDA37B;
}

</style>
{% endblock %}