
    <h1>Mes informations</h1>


    <table class="table">
        <tbody>
        <tr>
            <td>{{ user.name }}</td>
        </tr>
        <tr>
            <td>{{ user.email }}</td>
        </tr>

        <tr>
            <td> {% if user.diet %}
                    {{ user.diet.value }}
                {% else %}
                    Aucun régime alimentaire définie
                {% endif %}</td>

        </tr>
        <tr>
            <td>{% if user.allergy %}
                {{ user.allergy|map(a => a.value)|join(', ') }}
                {% else %}
                Aucune allergie définie
                {% endif %}
                </td>

        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_show', { 'id': user.id }) }}">Voir toutes mes informations</a>


