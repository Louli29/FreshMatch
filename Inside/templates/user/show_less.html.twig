{% block stylesheets %}
    <style>
        .form-container {
            background-color: #F2DAB4;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .no-border-table th, .no-border-table td {
            border: none;
        }

        h2 {
            margin-bottom: 15px;
            text-align: center; 
        }
    </style>
{% endblock %}

<div class="container mt-5">
    <div class="row">
        
        <div class="col-md-6">
            <h2>Mes informations</h2>
            <div class="form-container">
                <table class="table table-hover no-border-table">
                    <tbody>
                        <tr>
                            <th scope="row">Nom</th>
                            <td>{{ user.name }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Email</th>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Régime alimentaire</th>
                            <td>
                                {% if user.diet %}
                                    {{ user.diet.value }}
                                {% else %}
                                    Aucun régime alimentaire défini
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">Allergies</th>
                            <td>
                                {% if user.allergy %}
                                    {{ user.allergy|map(a => a.value)|join(', ') }}
                                {% else %}
                                    Aucune allergie définie
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="text-center mt-3">
                    <a href="{{ path('app_user_show', { 'id': user.id }) }}" class="btn btn-primary rounded">Voir toutes mes informations</a>
                </div>
            </div>
        </div>

    
        <div class="col-md-6">
            <h2>Mon placard</h2>

            <div class="form-container">
                {% include './list_ingr_user/index.html.twig' %}
            </div>
        </div>
    </div>
</div>
